@using CryptoTracker.Shared
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable

<div class="wizard-overlay" @onclick="OnCancel">
    <div class="wizard-container wizard-container-large" @onclick:stopPropagation="true">
        <div class="wizard-header">
            <h2>Transaktions-Verknüpfung</h2>
            <p class="wizard-subtitle">@GetStatusText()</p>
            <button type="button" class="wizard-close" @onclick="OnCancel">×</button>
        </div>

        <div class="wizard-content linking-wizard-content">
            @* Progress Section *@
            <div class="linking-progress-section">
                <div class="linking-progress-bar">
                    <div class="linking-progress-fill" style="width: @ProgressPercent%"></div>
                </div>
                <div class="linking-progress-stats">
                    <span>@ProcessedCount / @TotalCount Transaktionen</span>
                    @if (LinkedCount > 0 || MarkedExternalCount > 0 || SkippedCount > 0)
                    {
                        <span class="stats-detail">
                            ✓ @LinkedCount verknüpft | 
                            ⊕ @MarkedExternalCount extern | 
                            ⏭ @SkippedCount übersprungen
                        </span>
                    }
                </div>
            </div>

            @* Live Event Log *@
            <div class="linking-event-log" @ref="eventLogElement">
                @foreach (var evt in EventLog)
                {
                    <div class="linking-event @evt.CssClass">
                        <span class="event-icon">@evt.Icon</span>
                        <span class="event-message">@evt.Message</span>
                    </div>
                }
                @if (IsProcessing && CurrentQuestion == null)
                {
                    <div class="linking-event processing">
                        <span class="event-icon"><span class="loading-spinner-small"></span></span>
                        <span class="event-message">@ProcessingMessage</span>
                    </div>
                }
            </div>

            @* Question Section (inline) *@
            @if (CurrentQuestion != null)
            {
                <div class="linking-question-section">
                    <div class="question-header">
                        <span class="question-icon">❓</span>
                        <span>Agent fragt:</span>
                    </div>
                    <div class="question-content">
                        <p>@CurrentQuestion</p>
                        @if (CurrentTransaction != null)
                        {
                            <div class="question-transaction-preview">
                                <span class="type-badge @(CurrentTransaction.IsSend ? "send" : "receive")">
                                    @(CurrentTransaction.IsSend ? "Send" : "Receive")
                                </span>
                                <span class="tx-symbol">@CurrentTransaction.Symbol</span>
                                <span class="tx-amount">@CurrentTransaction.Quantity.ToString("N8")</span>
                                <span class="tx-wallet">@CurrentTransaction.WalletName</span>
                                <span class="tx-date">@CurrentTransaction.DateTime.ToString("dd.MM.yyyy HH:mm")</span>
                                @if (!string.IsNullOrEmpty(CurrentTransaction.Comment))
                                {
                                    <span class="tx-comment">"@CurrentTransaction.Comment"</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="question-options">
                        @if (CurrentOptions != null)
                        {
                            @foreach (var option in CurrentOptions)
                            {
                                <button type="button" 
                                        class="btn @GetOptionButtonClass(option)" 
                                        @onclick="() => OnOptionSelected(option)"
                                        disabled="@IsAnswering">
                                    @option
                                </button>
                            }
                            @* Freitext-Option *@
                            @if (!ShowFreeTextInput)
                            {
                                <button type="button" 
                                        class="btn btn-outline-secondary" 
                                        @onclick="ShowFreeText"
                                        disabled="@IsAnswering">
                                    Andere Begründung...
                                </button>
                            }
                        }
                    </div>
                    @if (ShowVirtualWalletSelection)
                    {
                        <div class="virtual-wallet-section">
                            <label>Vorhandenes virtuelles Wallet</label>
                            <select class="form-select" @bind="SelectedVirtualWalletId" disabled="@IsAnswering">
                                <option value="">Bitte wählen...</option>
                                @foreach (var wallet in VirtualWallets)
                                {
                                    <option value="@wallet.Id">@wallet.Name</option>
                                }
                            </select>
                            @if (IsLoadingVirtualWallets)
                            {
                                <div class="virtual-wallet-loading">
                                    <span class="loading-spinner-small"></span>
                                    <span>Lade virtuelle Wallets...</span>
                                </div>
                            }
                            @if (!IsLoadingVirtualWallets && VirtualWallets.Count == 0)
                            {
                                <div class="virtual-wallet-empty">Noch keine virtuellen Wallets vorhanden.</div>
                            }
                            <div class="virtual-wallet-divider">oder</div>
                            <label>Neues virtuelles Wallet</label>
                            <input class="form-control"
                                   placeholder="z.B. Extern - Binance"
                                   @bind="NewVirtualWalletName"
                                   disabled="@IsAnswering" />
                            <div class="virtual-wallet-actions">
                                <button type="button"
                                        class="btn btn-primary btn-sm"
                                        @onclick="LinkWithExistingVirtualWallet"
                                        disabled="@(SelectedVirtualWalletId == null || IsAnswering)">
                                    Verknüpfen
                                </button>
                                <button type="button"
                                        class="btn btn-outline-primary btn-sm"
                                        @onclick="CreateAndLinkVirtualWallet"
                                        disabled="@(string.IsNullOrWhiteSpace(NewVirtualWalletName) || IsAnswering)">
                                    Neu anlegen &amp; verknüpfen
                                </button>
                                <button type="button"
                                        class="btn btn-secondary btn-sm"
                                        @onclick="CancelVirtualWalletSelection"
                                        disabled="@IsAnswering">
                                    Abbrechen
                                </button>
                            </div>
                        </div>
                    }
                    @* Freitext-Eingabe *@
                    @if (ShowFreeTextInput)
                    {
                        <div class="freetext-input-section">
                            <label>Eigene Begründung eingeben:</label>
                            <textarea class="form-control" rows="2" @bind="FreeTextInput" placeholder="Beschreibe die Situation..."></textarea>
                            <div class="freetext-actions">
                                <button type="button" class="btn btn-primary btn-sm" @onclick="SubmitFreeText" disabled="@(string.IsNullOrWhiteSpace(FreeTextInput) || IsAnswering)">
                                    Absenden
                                </button>
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="CancelFreeText">
                                    Abbrechen
                                </button>
                            </div>
                        </div>
                    }
                    <div class="question-remember">
                        <label>
                            <input type="checkbox" @bind="ShouldRemember" />
                            Diese Entscheidung für ähnliche Fälle merken
                        </label>
                    </div>
                </div>
            }

            @* Learned Rules Section *@
            @if (LearnedRules.Count > 0)
            {
                <div class="linking-rules-section">
                    <div class="rules-header" @onclick="ToggleRulesExpanded">
                        <span>@(RulesExpanded ? "▼" : "▶") Gelernte Regeln (@LearnedRules.Count)</span>
                    </div>
                    @if (RulesExpanded)
                    {
                        <div class="rules-list">
                            @foreach (var rule in LearnedRules)
                            {
                                <div class="rule-item">
                                    <span class="rule-pattern">"@rule.Pattern"</span>
                                    <span class="rule-arrow">→</span>
                                    <span class="rule-action">@rule.Description</span>
                                    <span class="rule-count">(@rule.TimesApplied× angewendet)</span>
                                    <button type="button" class="btn-icon" @onclick="() => DeleteRule(rule.Id)" title="Regel löschen">
                                        🗑
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @* Start / Completion Section *@
            @if (!IsStarted)
            {
                <div class="linking-start-section">
                    <div class="wizard-icon">🔗</div>
                    <h3>Interaktive Transaktions-Verknüpfung</h3>
                    <p>
                        Der Assistent verknüpft automatisch passende Send/Receive-Paare.
                        Bei unklaren Fällen wirst du um Bestätigung gebeten.
                    </p>
                    @if (Statistics != null)
                    {
                        <div class="wizard-stats-preview">
                            <div class="stats-row">
                                <div class="stat-item">
                                    <span class="stat-number">@Statistics.UnlinkedTransactions</span>
                                    <span class="stat-label">Unverknüpfte Transaktionen</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-number">@Statistics.LinkedTransactions</span>
                                    <span class="stat-label">Bereits verknüpft</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-number">@Statistics.IntentionallyUnlinked</span>
                                    <span class="stat-label">Als extern markiert</span>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="wizard-action-area">
                        <button type="button" class="btn btn-primary btn-lg" @onclick="StartInteractiveSession" disabled="@IsConnecting">
                            @if (IsConnecting)
                            {
                                <span class="loading-spinner-small"></span>
                                <span>Verbinde...</span>
                            }
                            else
                            {
                                <span>Verknüpfung starten</span>
                            }
                        </button>
                    </div>
                </div>
            }
            else if (IsCompleted)
            {
                <div class="linking-complete-section">
                    <div class="wizard-icon success">✓</div>
                    <h3>Verknüpfung abgeschlossen!</h3>
                    <div class="result-stats">
                        <div class="result-stat">
                            <span class="result-number success">@LinkedCount</span>
                            <span class="result-label">Verknüpft</span>
                        </div>
                        <div class="result-stat">
                            <span class="result-number info">@MarkedExternalCount</span>
                            <span class="result-label">Extern markiert</span>
                        </div>
                        @if (SkippedCount > 0)
                        {
                            <div class="result-stat">
                                <span class="result-number warning">@SkippedCount</span>
                                <span class="result-label">Übersprungen</span>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Error Display *@
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="linking-error">
                    <span>⚠</span> @ErrorMessage
                </div>
            }
        </div>

        <div class="wizard-footer">
            @if (IsStarted && !IsCompleted)
            {
                <button type="button" class="btn btn-secondary" @onclick="StopSession" disabled="@IsAnswering">
                    Abbrechen
                </button>
            }
            <div class="wizard-footer-spacer"></div>
            @if (IsCompleted || !IsStarted)
            {
                <button type="button" class="btn btn-primary" @onclick="Complete">
                    @(IsCompleted ? "Fertig" : "Schließen")
                </button>
            }
        </div>
    </div>
</div>

<style>
    .wizard-container-large {
        max-width: 800px;
        max-height: 90vh;
    }

    .linking-wizard-content {
        display: flex;
        flex-direction: column;
        gap: 16px;
        min-height: 400px;
    }

    .linking-progress-section {
        padding: 12px 16px;
        background: var(--bs-light);
        border-radius: 8px;
    }

    .linking-progress-bar {
        height: 8px;
        background: #e0e0e0;
        border-radius: 4px;
        overflow: hidden;
    }

    .linking-progress-fill {
        height: 100%;
        background: var(--bs-primary);
        transition: width 0.3s ease;
    }

    .linking-progress-stats {
        display: flex;
        justify-content: space-between;
        margin-top: 8px;
        font-size: 0.85rem;
        color: #666;
    }

    .stats-detail {
        color: #888;
    }

    .linking-event-log {
        flex: 1;
        min-height: 150px;
        max-height: 250px;
        overflow-y: auto;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 12px;
        background: #fafafa;
    }

    .linking-event {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 0;
        font-size: 0.9rem;
        border-bottom: 1px solid #eee;
    }

    .linking-event:last-child {
        border-bottom: none;
    }

    .linking-event.linked {
        color: #28a745;
    }

    .linking-event.external {
        color: #17a2b8;
    }

    .linking-event.skipped {
        color: #6c757d;
    }

    .linking-event.error {
        color: #dc3545;
    }

    .linking-event.rule {
        color: #6f42c1;
    }

    .linking-event.processing {
        color: #666;
    }

    .event-icon {
        width: 20px;
        text-align: center;
    }

    .linking-question-section {
        background: #fff8e1;
        border: 2px solid #ffc107;
        border-radius: 8px;
        padding: 16px;
    }

    .question-header {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .question-icon {
        font-size: 1.2rem;
    }

    .question-content p {
        margin: 0 0 12px 0;
    }

    .question-transaction-preview {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        padding: 8px 12px;
        background: #fff;
        border-radius: 4px;
        font-size: 0.9rem;
    }

    .tx-comment {
        color: #666;
        font-style: italic;
    }

    .question-options {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 12px;
    }

    .question-remember {
        margin-top: 12px;
        font-size: 0.9rem;
    }

    .question-remember label {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    .freetext-input-section {
        margin-top: 12px;
        padding: 12px;
        background: #fff;
        border-radius: 4px;
        border: 1px solid #ddd;
    }

    .freetext-input-section label {
        display: block;
        margin-bottom: 8px;
        font-weight: 500;
    }

    .freetext-input-section textarea {
        margin-bottom: 8px;
    }

    .freetext-actions {
        display: flex;
        gap: 8px;
    }

    .virtual-wallet-section {
        margin-top: 12px;
        padding: 12px;
        background: #f5f9ff;
        border: 1px dashed #90caf9;
        border-radius: 6px;
    }

    .virtual-wallet-section label {
        display: block;
        margin: 6px 0 4px;
        font-weight: 500;
    }

    .virtual-wallet-divider {
        margin: 10px 0;
        font-size: 0.8rem;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .virtual-wallet-actions {
        display: flex;
        gap: 8px;
        margin-top: 10px;
        flex-wrap: wrap;
    }

    .virtual-wallet-loading {
        margin-top: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
        color: #666;
    }

    .virtual-wallet-empty {
        margin-top: 6px;
        font-size: 0.85rem;
        color: #888;
    }

    .linking-rules-section {
        border: 1px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
    }

    .rules-header {
        padding: 10px 16px;
        background: #f5f5f5;
        cursor: pointer;
        font-weight: 500;
        user-select: none;
    }

    .rules-header:hover {
        background: #eee;
    }

    .rules-list {
        padding: 8px 16px;
    }

    .rule-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 0;
        font-size: 0.9rem;
        border-bottom: 1px solid #eee;
    }

    .rule-item:last-child {
        border-bottom: none;
    }

    .rule-pattern {
        font-family: monospace;
        background: #e9ecef;
        padding: 2px 6px;
        border-radius: 3px;
    }

    .rule-arrow {
        color: #888;
    }

    .rule-action {
        flex: 1;
    }

    .rule-count {
        color: #888;
        font-size: 0.8rem;
    }

    .btn-icon {
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        opacity: 0.6;
    }

    .btn-icon:hover {
        opacity: 1;
    }

    .linking-start-section,
    .linking-complete-section {
        text-align: center;
        padding: 20px;
    }

    .linking-start-section h3,
    .linking-complete-section h3 {
        margin-bottom: 12px;
    }

    .linking-error {
        padding: 12px 16px;
        background: #f8d7da;
        border: 1px solid #f5c6cb;
        border-radius: 8px;
        color: #721c24;
    }

    .type-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    .type-badge.send {
        background: #f8d7da;
        color: #721c24;
    }

    .type-badge.receive {
        background: #d4edda;
        color: #155724;
    }

    .tx-symbol {
        font-weight: 600;
    }

    .tx-wallet {
        color: #666;
    }

    .tx-date {
        color: #888;
        font-size: 0.85rem;
    }
</style>
