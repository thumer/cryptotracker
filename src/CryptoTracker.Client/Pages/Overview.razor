@page "/"
@using CryptoTracker.Shared
@inject IOverviewApi OverviewApi

<PageTitle>Überblick</PageTitle>

<div class="page-header">
    <div>
        <h1>Überblick</h1>
        <p class="page-subtitle">Gesamtstatus deiner Wallets und wichtigsten Coins auf einen Blick.</p>
    </div>
</div>

<LoadingOverlay IsLoading="IsLoading" Text="Lade Überblick…" />

@if (!IsLoading && Summary != null)
{
    <section class="overview-hero">
        <div class="hero-main">
            <div class="hero-label">Gesamtsaldo</div>
            <div class="hero-value">@FormatHelper.FormatEuro(Summary.TotalEuroValue)</div>
            <div class="hero-meta">@Summary.CoinCount Coins</div>
        </div>
        <div class="hero-topcoins">
            <div class="topcoins-title">Top 3 Coins</div>
            @if (Summary.TopCoins.Count == 0)
            {
                <div class="topcoins-empty">Noch keine Coins vorhanden.</div>
            }
            else
            {
                <div class="topcoins-list">
                    @foreach (var coin in Summary.TopCoins)
                    {
                        <div class="topcoin-row">
                            <CoinLink Symbol="@coin.Symbol" Slug="@coin.Slug" />
                            <span class="topcoin-amount">@FormatHelper.FormatAmount(coin.Amount)</span>
                            <span class="topcoin-value">@FormatHelper.FormatEuro(coin.EuroValue)</span>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <section class="wallet-grid">
        @foreach (var wallet in Summary.Wallets)
        {
            <button type="button" class="wallet-card" @onclick="(() => NavigateToWallet(wallet.WalletName))">
                <div class="wallet-name">@wallet.WalletName</div>
                <div class="wallet-value">@FormatHelper.FormatEuro(wallet.EuroValue)</div>
                <div class="wallet-meta">@wallet.AssetCount Assets</div>
            </button>
        }
    </section>
}

@if (ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert" style="margin-top:20px">
        @ErrorMessage
    </div>
}
