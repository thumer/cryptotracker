@page "/bilanzen"
@using CryptoTracker.Client.Common
@using CryptoTracker.Client.Shared
@using CryptoTracker.Shared
@inject IBalanceApi BalanceApi
@inject IWalletApi WalletApi

<PageTitle>Bilanzen</PageTitle>

<div class="page-header">
    <div>
        <h1>Bilanzen</h1>
        <p class="page-subtitle">Wallet-Überblick mit Einzelwerten je Asset.</p>
    </div>
</div>

<LoadingOverlay IsLoading="IsLoading" Text="Lade Bilanzen…" />

@if (WalletNavItems.Count > 0)
{
    <TopNavigator Items="WalletNavItems" SelectedValue="@SelectedWalletName" ActiveValue="@SelectedWalletName" SelectedValueChanged="OnWalletChanged" />
}

@if (!IsLoading && SelectedBalance != null)
{
    <section class="wallet-summary">
        <div class="wallet-summary-total">Gesamt: <span>@FormatHelper.FormatAmount(SelectedBalance.TotalEuroValue)€</span></div>
        <div class="wallet-summary-meta">@SelectedBalance.Assets.Count Assets</div>
    </section>

    @if (SelectedBalance.Assets.Count == 0)
    {
        <div class="empty-state">Keine Assets in dieser Wallet gefunden.</div>
    }
    else
    {
        <RadzenDataGrid TItem="AssetBalanceDetailDTO" Data="SelectedBalance.Assets" AllowSorting="false" AllowFiltering="false" AllowColumnResize="true" AllowPaging="false" RowSelect="OnAssetSelected" Class="styled-grid row-clickable">
            <Columns>
                <RadzenDataGridColumn TItem="AssetBalanceDetailDTO" Title="Symbol">
                    <Template Context="asset">
                        <CoinLink Symbol="@asset.Symbol" Slug="@asset.Slug" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AssetBalanceDetailDTO" Title="Menge">
                    <Template Context="asset">
                        @FormatHelper.FormatAmount(asset.Amount)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AssetBalanceDetailDTO" Title="Wert €">
                    <Template Context="asset">
                        @FormatHelper.FormatEuro(asset.EuroValue)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AssetBalanceDetailDTO" Title="Kurs €">
                    <Template Context="asset">
                        @FormatHelper.FormatEuro(asset.RateEur)
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
}

@if (ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert" style="margin-top:20px">@ErrorMessage</div>
}
