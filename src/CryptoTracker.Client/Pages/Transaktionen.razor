@page "/transaktionen"
@using CryptoTracker.Client.Common
@using CryptoTracker.Client.Shared
@using CryptoTracker.Shared
@inject ITransactionsApi TransactionsApi
@inject IWalletApi WalletApi
@inject ILotsApi LotsApi

<PageTitle>Transaktionen</PageTitle>

<div class="page-header">
    <div>
        <h1>Transaktionen</h1>
        <p class="page-subtitle">Alle Bewegungen, sauber filterbar nach Wallet und Coin.</p>
    </div>
</div>

<LoadingOverlay IsLoading="IsLoading" Text="Lade Transaktionen…" />

@if (WalletNavItems.Count > 0)
{
    <TopNavigator Items="WalletNavItems" SelectedValue="@SelectedWalletName" ActiveValue="@SelectedWalletName" SelectedValueChanged="OnWalletChanged" />
}

@if (CoinNavItems.Count > 0)
{
    <TopNavigator Items="CoinNavItems" SelectedValue="@SelectedCoinSymbol" ActiveValue="@SelectedCoinSymbol" SelectedValueChanged="OnCoinChanged" />
}

@if (!IsLoading)
{
    @if (Transactions.Count == 0)
    {
        <div class="empty-state">Keine Transaktionen gefunden.</div>
    }
    else
    {
        <RadzenDataGrid TItem="TransactionRowDTO" Data="Transactions" KeyProperty="@nameof(TransactionRowDTO.RowKey)" AllowSorting="false" AllowFiltering="false" AllowColumnResize="true" AllowPaging="false" Class="styled-grid">
            <Columns>
                <RadzenDataGridColumn TItem="TransactionRowDTO" Title="Datum (UTC)">
                    <Template Context="row">
                        @FormatHelper.FormatUtc(row.DateTime)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TransactionRowDTO" Title="Typ">
                    <Template Context="row">
                        @(row.FlowType == FlowType.Trade ? "Trade" : "Transaction")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TransactionRowDTO" Title="Flow">
                    <Template Context="row">
                        <span class="flow-badge @(row.FlowDirection == FlowDirection.Inflow ? "flow-in" : "flow-out")">
                            <span class="flow-arrow" aria-hidden="true">@(row.FlowDirection == FlowDirection.Inflow ? "\u2193" : "\u2191")</span>
                            @(row.FlowDirection == FlowDirection.Inflow ? "Eingang" : "Ausgang")
                        </span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TransactionRowDTO" Title="Coin">
                    <Template Context="row">
                        <CoinLink Symbol="@row.Symbol" Slug="@row.Slug" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TransactionRowDTO" Title="Anzahl">
                    <Template Context="row">
                        @FormatHelper.FormatAmount(row.Amount)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TransactionRowDTO" Title="Wert €">
                    <Template Context="row">
                        @FormatHelper.FormatEuro(row.EuroValue)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TransactionRowDTO" Title="Gebühr">
                    <Template Context="row">
                        @if (row.Fee > 0)
                        {
                            <span>@FormatHelper.FormatAmount(row.Fee) @row.Symbol</span>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TransactionRowDTO" Title="Ziel-Coin">
                    <Template Context="row">
                        @if (row.FlowType == FlowType.Trade && !string.IsNullOrWhiteSpace(row.TargetSymbol))
                        {
                            <CoinLink Symbol="@row.TargetSymbol" Slug="@row.TargetSlug" />
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TransactionRowDTO" Title="Ziel-Menge">
                    <Template Context="row">
                        @if (row.FlowType == FlowType.Trade && row.TargetAmount.HasValue)
                        {
                            @FormatHelper.FormatAmount(row.TargetAmount.Value)
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TransactionRowDTO" Title="Source Wallet">
                    <Template Context="row">
                        @(string.IsNullOrWhiteSpace(row.SourceWallet) ? "—" : row.SourceWallet)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TransactionRowDTO" Title="Target Wallet">
                    <Template Context="row">
                        @(string.IsNullOrWhiteSpace(row.TargetWallet) ? "—" : row.TargetWallet)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TransactionRowDTO" Title="" Width="140px">
                    <Template Context="row">
                        <div class="action-buttons">
                            <button type="button" class="details-button" @onclick="async () => await OpenDetailsAsync(row)">Details</button>
                            @if (RequiresLotAssignment(row))
                            {
                                <button type="button" class="lot-button" @onclick="() => OpenLotAssignmentAsync(row)">Lots</button>
                            }
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
}

@if (ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert" style="margin-top:20px">@ErrorMessage</div>
}

@* Details Modal *@
@if (IsDetailsOpen)
{
    <div class="modal-overlay" @onclick="CloseDetails">
        <div class="modal-card details-modal" @onclick:stopPropagation="true">
            <div class="details-header">
                <h3>Details</h3>
                <button type="button" class="details-close" @onclick="CloseDetails">x</button>
            </div>

            @if (IsDetailsLoading)
            {
                <div class="details-loading">
                    <div class="loading-spinner"></div>
                    <span>Lade Details...</span>
                </div>
            }
            else if (DetailsError != null)
            {
                <div class="alert alert-danger" role="alert">@DetailsError</div>
            }
            else if (Details == null)
            {
                <div class="empty-state">Keine Details gefunden.</div>
            }
            else if (Details.FlowType == FlowType.Trade && Details.Trade != null)
            {
                <div class="details-section">
                    <div class="details-title">Trade</div>
                    <div class="details-grid">
                        <div class="details-item">
                            <label>Datum</label>
                            <span>@FormatHelper.FormatUtc(Details.Trade.DateTime)</span>
                        </div>
                        <div class="details-item">
                            <label>Flow</label>
                            <span>@(Details.Trade.FlowDirection == FlowDirection.Inflow ? "Eingang" : "Ausgang")</span>
                        </div>
                        <div class="details-item">
                            <label>Coin</label>
                            <span><CoinLink Symbol="@Details.Trade.Symbol" Slug="@Details.Trade.Slug" /></span>
                        </div>
                        <div class="details-item">
                            <label>Anzahl</label>
                            <span>@FormatHelper.FormatAmount(Details.Trade.Amount)</span>
                        </div>
                        <div class="details-item">
                            <label>Wert</label>
                            <span>@FormatHelper.FormatEuro(Details.Trade.EuroValue)</span>
                        </div>
                        <div class="details-item">
                            <label>Ziel-Coin</label>
                            <span>
                                @if (!string.IsNullOrWhiteSpace(Details.Trade.TargetSymbol))
                                {
                                    <CoinLink Symbol="@Details.Trade.TargetSymbol" Slug="@Details.Trade.TargetSlug" />
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </span>
                        </div>
                        <div class="details-item">
                            <label>Ziel-Menge</label>
                            <span>@(Details.Trade.TargetAmount.HasValue ? FormatHelper.FormatAmount(Details.Trade.TargetAmount.Value) : "—")</span>
                        </div>
                        <div class="details-item">
                            <label>Wallet</label>
                            <span>@Details.Trade.Wallet</span>
                        </div>
                        <div class="details-item">
                            <label>Gebühr</label>
                            <span>@FormatHelper.FormatAmount(Details.Trade.Fee) @Details.Trade.FeeSymbol</span>
                        </div>
                        <div class="details-item">
                            <label>Fremdgebühr</label>
                            <span>@(Details.Trade.ForeignFee > 0 ? $"{FormatHelper.FormatAmount(Details.Trade.ForeignFee)} {Details.Trade.ForeignFeeSymbol}" : "—")</span>
                        </div>
                        <div class="details-item">
                            <label>Referenz</label>
                            <span>@(string.IsNullOrWhiteSpace(Details.Trade.Referenz) ? "—" : Details.Trade.Referenz)</span>
                        </div>
                        <div class="details-item">
                            <label>Kommentar</label>
                            <span>@(string.IsNullOrWhiteSpace(Details.Trade.Comment) ? "—" : Details.Trade.Comment)</span>
                        </div>
                    </div>
                </div>

                <div class="details-section details-opposite">
                    <div class="details-title">Opposite Trade</div>
                    @if (Details.OppositeTrade == null)
                    {
                        <div class="details-empty">Kein Opposite-Trade vorhanden.</div>
                    }
                    else
                    {
                        <div class="details-grid">
                            <div class="details-item">
                                <label>Datum</label>
                                <span>@FormatHelper.FormatUtc(Details.OppositeTrade.DateTime)</span>
                            </div>
                            <div class="details-item">
                                <label>Flow</label>
                                <span>@(Details.OppositeTrade.FlowDirection == FlowDirection.Inflow ? "Eingang" : "Ausgang")</span>
                            </div>
                            <div class="details-item">
                                <label>Coin</label>
                                <span><CoinLink Symbol="@Details.OppositeTrade.Symbol" Slug="@Details.OppositeTrade.Slug" /></span>
                            </div>
                            <div class="details-item">
                                <label>Anzahl</label>
                                <span>@FormatHelper.FormatAmount(Details.OppositeTrade.Amount)</span>
                            </div>
                            <div class="details-item">
                                <label>Wert</label>
                                <span>@FormatHelper.FormatEuro(Details.OppositeTrade.EuroValue)</span>
                            </div>
                            <div class="details-item">
                                <label>Ziel-Coin</label>
                                <span>
                                    @if (!string.IsNullOrWhiteSpace(Details.OppositeTrade.TargetSymbol))
                                    {
                                        <CoinLink Symbol="@Details.OppositeTrade.TargetSymbol" Slug="@Details.OppositeTrade.TargetSlug" />
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </span>
                            </div>
                            <div class="details-item">
                                <label>Ziel-Menge</label>
                                <span>@(Details.OppositeTrade.TargetAmount.HasValue ? FormatHelper.FormatAmount(Details.OppositeTrade.TargetAmount.Value) : "—")</span>
                            </div>
                            <div class="details-item">
                                <label>Wallet</label>
                                <span>@Details.OppositeTrade.Wallet</span>
                            </div>
                            <div class="details-item">
                                <label>Gebühr</label>
                                <span>@FormatHelper.FormatAmount(Details.OppositeTrade.Fee) @Details.OppositeTrade.FeeSymbol</span>
                            </div>
                            <div class="details-item">
                                <label>Fremdgebühr</label>
                                <span>@(Details.OppositeTrade.ForeignFee > 0 ? $"{FormatHelper.FormatAmount(Details.OppositeTrade.ForeignFee)} {Details.OppositeTrade.ForeignFeeSymbol}" : "—")</span>
                            </div>
                            <div class="details-item">
                                <label>Referenz</label>
                                <span>@(string.IsNullOrWhiteSpace(Details.OppositeTrade.Referenz) ? "—" : Details.OppositeTrade.Referenz)</span>
                            </div>
                            <div class="details-item">
                                <label>Kommentar</label>
                                <span>@(string.IsNullOrWhiteSpace(Details.OppositeTrade.Comment) ? "—" : Details.OppositeTrade.Comment)</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (Details.FlowType == FlowType.Transaction && Details.Transaction != null)
            {
                <div class="details-section">
                    <div class="details-title">Transaktion</div>
                    <div class="details-grid">
                        <div class="details-item">
                            <label>Datum</label>
                            <span>@FormatHelper.FormatUtc(Details.Transaction.DateTime)</span>
                        </div>
                        <div class="details-item">
                            <label>Flow</label>
                            <span>@(Details.Transaction.FlowDirection == FlowDirection.Inflow ? "Eingang" : "Ausgang")</span>
                        </div>
                        <div class="details-item">
                            <label>Coin</label>
                            <span><CoinLink Symbol="@Details.Transaction.Symbol" Slug="@Details.Transaction.Slug" /></span>
                        </div>
                        <div class="details-item">
                            <label>Anzahl</label>
                            <span>@FormatHelper.FormatAmount(Details.Transaction.Amount)</span>
                        </div>
                        <div class="details-item">
                            <label>Wert</label>
                            <span>@FormatHelper.FormatEuro(Details.Transaction.EuroValue)</span>
                        </div>
                        <div class="details-item">
                            <label>Source Wallet</label>
                            <span>@(string.IsNullOrWhiteSpace(Details.Transaction.SourceWallet) ? "—" : Details.Transaction.SourceWallet)</span>
                        </div>
                        <div class="details-item">
                            <label>Ziel Wallet</label>
                            <span>@(string.IsNullOrWhiteSpace(Details.Transaction.TargetWallet) ? "—" : Details.Transaction.TargetWallet)</span>
                        </div>
                        <div class="details-item">
                            <label>Gebühr</label>
                            <span>@FormatHelper.FormatAmount(Details.Transaction.Fee) @Details.Transaction.FeeSymbol</span>
                        </div>
                        <div class="details-item">
                            <label>Kommentar</label>
                            <span>@(string.IsNullOrWhiteSpace(Details.Transaction.Comment) ? "—" : Details.Transaction.Comment)</span>
                        </div>
                        <div class="details-item">
                            <label>TransactionId</label>
                            <span>@(string.IsNullOrWhiteSpace(Details.Transaction.TransactionId) ? "—" : Details.Transaction.TransactionId)</span>
                        </div>
                        <div class="details-item">
                            <label>Address</label>
                            <span>@(string.IsNullOrWhiteSpace(Details.Transaction.Address) ? "—" : Details.Transaction.Address)</span>
                        </div>
                        <div class="details-item">
                            <label>Network</label>
                            <span>@(string.IsNullOrWhiteSpace(Details.Transaction.Network) ? "—" : Details.Transaction.Network)</span>
                        </div>
                    </div>
                </div>

                <div class="details-section details-opposite">
                    <div class="details-title">Opposite Transaktion</div>
                    @if (Details.OppositeTransaction == null)
                    {
                        <div class="details-empty">Keine Opposite-Transaktion vorhanden.</div>
                    }
                    else
                    {
                        <div class="details-grid">
                            <div class="details-item">
                                <label>Datum</label>
                                <span>@FormatHelper.FormatUtc(Details.OppositeTransaction.DateTime)</span>
                            </div>
                            <div class="details-item">
                                <label>Flow</label>
                                <span>@(Details.OppositeTransaction.FlowDirection == FlowDirection.Inflow ? "Eingang" : "Ausgang")</span>
                            </div>
                            <div class="details-item">
                                <label>Coin</label>
                                <span><CoinLink Symbol="@Details.OppositeTransaction.Symbol" Slug="@Details.OppositeTransaction.Slug" /></span>
                            </div>
                            <div class="details-item">
                                <label>Anzahl</label>
                                <span>@FormatHelper.FormatAmount(Details.OppositeTransaction.Amount)</span>
                            </div>
                            <div class="details-item">
                                <label>Wert</label>
                                <span>@FormatHelper.FormatEuro(Details.OppositeTransaction.EuroValue)</span>
                            </div>
                            <div class="details-item">
                                <label>Source Wallet</label>
                                <span>@(string.IsNullOrWhiteSpace(Details.OppositeTransaction.SourceWallet) ? "—" : Details.OppositeTransaction.SourceWallet)</span>
                            </div>
                            <div class="details-item">
                                <label>Ziel Wallet</label>
                                <span>@(string.IsNullOrWhiteSpace(Details.OppositeTransaction.TargetWallet) ? "—" : Details.OppositeTransaction.TargetWallet)</span>
                            </div>
                            <div class="details-item">
                                <label>Gebühr</label>
                                <span>@FormatHelper.FormatAmount(Details.OppositeTransaction.Fee) @Details.OppositeTransaction.FeeSymbol</span>
                            </div>
                            <div class="details-item">
                                <label>Kommentar</label>
                                <span>@(string.IsNullOrWhiteSpace(Details.OppositeTransaction.Comment) ? "—" : Details.OppositeTransaction.Comment)</span>
                            </div>
                            <div class="details-item">
                                <label>TransactionId</label>
                                <span>@(string.IsNullOrWhiteSpace(Details.OppositeTransaction.TransactionId) ? "—" : Details.OppositeTransaction.TransactionId)</span>
                            </div>
                            <div class="details-item">
                                <label>Address</label>
                                <span>@(string.IsNullOrWhiteSpace(Details.OppositeTransaction.Address) ? "—" : Details.OppositeTransaction.Address)</span>
                            </div>
                            <div class="details-item">
                                <label>Network</label>
                                <span>@(string.IsNullOrWhiteSpace(Details.OppositeTransaction.Network) ? "—" : Details.OppositeTransaction.Network)</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@* Lot Assignment Modal *@
@if (IsLotAssignmentOpen && LotAssignmentRow != null)
{
    <div class="modal-overlay" @onclick="CloseLotAssignment">
        <div class="modal-card lot-assignment-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Lot-Zuordnung</h3>
                <button type="button" class="details-close" @onclick="CloseLotAssignment">×</button>
            </div>
            <div class="modal-body">
                <div class="lot-assignment-info">
                    <div class="lot-assignment-info-item">
                        <label>Datum</label>
                        <span>@FormatHelper.FormatUtc(LotAssignmentRow.DateTime)</span>
                    </div>
                    <div class="lot-assignment-info-item">
                        <label>Typ</label>
                        <span>@(IsSellTrade(LotAssignmentRow) ? "Verkauf" : "Transfer")</span>
                    </div>
                    <div class="lot-assignment-info-item">
                        <label>Coin</label>
                        <span><CoinLink Symbol="@LotAssignmentRow.Symbol" Slug="@LotAssignmentRow.Slug" /></span>
                    </div>
                    <div class="lot-assignment-info-item">
                        <label>Menge</label>
                        <span>@FormatHelper.FormatAmount(LotAssignmentRow.Amount) @LotAssignmentRow.Symbol</span>
                    </div>
                    @if (IsSellTrade(LotAssignmentRow))
                    {
                        <div class="lot-assignment-info-item">
                            <label>Verkaufswert</label>
                            <span>@FormatHelper.FormatEuro(LotAssignmentRow.EuroValue)</span>
                        </div>
                    }
                </div>

                <hr style="margin: 15px 0; border-color: var(--border-color);" />

                @if (IsLotAssignmentConfirmed)
                {
                    <div class="lot-assignment-confirmed">
                        <span class="text-success">Lot-Zuordnung bereits bestätigt</span>
                    </div>
                }
                else
                {
                    <p class="text-muted">
                        @if (IsSellTrade(LotAssignmentRow))
                        {
                            <text>Wählen Sie die Lots aus, die für diesen Verkauf verwendet werden sollen. Es werden nur Lots angezeigt, die VOR dem Verkaufsdatum erworben wurden.</text>
                        }
                        else
                        {
                            <text>Wählen Sie die Lots aus, die mit diesem Transfer übertragen werden sollen. Die Anschaffungskosten werden auf das Ziel-Wallet übernommen.</text>
                        }
                    </p>
                    
                    <LotSelector WalletName="@GetLotAssignmentWallet()"
                                 Symbol="@LotAssignmentRow.Symbol"
                                 RequiredQuantity="@LotAssignmentRow.Amount"
                                 MaxAcquisitionDate="@LotAssignmentRow.DateTime"
                                 PrioritizeAltbestand="@IsSellTrade(LotAssignmentRow)"
                                 ShowTaxPreview="@IsSellTrade(LotAssignmentRow)"
                                 SalePriceEur="@(IsSellTrade(LotAssignmentRow) ? LotAssignmentRow.EuroValue / LotAssignmentRow.Amount : null)"
                                 LotsApi="LotsApi"
                                 SelectionChanged="OnLotSelectionChanged" />
                }
                
                @if (LotAssignmentError != null)
                {
                    <div class="alert alert-danger" style="margin-top:15px">@LotAssignmentError</div>
                }
                @if (LotAssignmentSuccess != null)
                {
                    <div class="alert alert-success" style="margin-top:15px">@LotAssignmentSuccess</div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseLotAssignment">Schließen</button>
                @if (!IsLotAssignmentConfirmed && SelectedLotAllocations.Count > 0)
                {
                    <button type="button" class="btn btn-primary" @onclick="ConfirmLotAssignment" disabled="@IsConfirmingLotAssignment">
                        @if (IsConfirmingLotAssignment)
                        {
                            <span class="loading-spinner-small"></span>
                            <span>Speichere...</span>
                        }
                        else
                        {
                            <span>Lot-Zuordnung bestätigen</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>
}
